# the exact builds retail used (see docs/SETUP.md).
/tools/dsd.exe
/tools/dsd
/tools/objdiff-cli.exe
/tools/objdiff-cli
/tools/sjiswrap.exe
/tools/sjiswrap
/tools/wibo
/tools/binutils/
/tools/msvc/
/tools/wibo-deadbeef/

# Python
__pycache__/
*.pyc
