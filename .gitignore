# A dump of the cartridge, its extraction and the ARM7 BIOS must never be
# committed. See docs/SETUP.md.
/extract/
*.nds
*.srl
arm7_bios.bin
*.sha1.local

# Build output
/build/
/build.ninja
/build.ninja.d
*.o
*.d
compile_commands.json

# Downloaded toolchain binaries. The CodeWarrior ARM compilers under
