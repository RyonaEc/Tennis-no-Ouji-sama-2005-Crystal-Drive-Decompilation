# A dump of the cartridge, its extraction and the ARM7 BIOS must never be
# committed. See docs/SETUP.md. Everything else in this repository, including
# tools/, is meant to be redistributed.
/extract/
*.nds
*.srl
arm7_bios.bin
*.sha1.local

# Build output. Only the helper scripts and their rosters are tracked, so
# everything else under build/ - delinked objects, the built ROM, scratch
# candidates, logs, probes, Ghidra dumps and backup copies - stays out.
/build/*
!/build/*.py
!/build/*.txt
/build.ninja
/build.ninja.d
*.o
*.d
compile_commands.json

# Python
__pycache__/
*.pyc
