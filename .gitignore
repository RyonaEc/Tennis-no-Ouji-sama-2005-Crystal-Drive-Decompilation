# A dump of the cartridge, its extraction and the ARM7 BIOS must never be
# committed. See docs/SETUP.md. Everything else in this repository, including
# tools/, is meant to be redistributed.
/extract/
*.nds
*.srl
arm7_bios.bin
*.sha1.local

# Build output and scratch. Everything under build/ - delinked objects, the
# built ROM, scratch candidates, logs, probes and Ghidra dumps - stays out.
/build/*
/build.ninja
/build.ninja.d
*.o
*.d
compile_commands.json

# Python
__pycache__/
*.pyc
